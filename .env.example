# WorldView Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Google Maps API Key
# =============================================================================
# Used for Google 3D Tiles and geocoding
# Get one at: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_TILE_API_KEY=your_google_maps_api_key_here

# =============================================================================
# OPTIONAL: AISStream API Key (for ship tracking)
# =============================================================================
# Used for real-time ship tracking via AIS data
# Get one at: https://aisstream.io/
# If not set, ship tracking will be disabled
AISSTREAM_API_KEY=your_aisstream_api_key_here

# =============================================================================
# OPTIONAL: Proxy Server Configuration
# =============================================================================
# Base URL for the proxy server (used by frontend)
# Defaults to http://localhost:3001 if not set
PROXY_BASE_URL=http://localhost:3001

# =============================================================================
# OPTIONAL: Development Server Configuration
# =============================================================================
# Port for the development server (defaults to 3000)
DEV_SERVER_PORT=3000

# Port for the proxy server (defaults to 3001)
PROXY_SERVER_PORT=3001
FIVE11_NY_KEY=
FIVE11_PA_KEY=
FIVE11_LA_KEY=
FIVE11_WI_KEY=
FIVE11_GA_KEY=
FIVE11_MI_KEY=
